rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Keep this list in sync with NEXT_PUBLIC_ADMIN_EMAILS
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['miesieduoveria@gmail.com'];
    }

    // Portfolio content is public to read; only the admin can change it
    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
