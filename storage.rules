rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Keep this list in sync with NEXT_PUBLIC_ADMIN_EMAILS
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['miesieduoveria@gmail.com'];
    }

    // Uploaded images are public to read; only the admin can upload images under 15MB
    match /{allPaths=**} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
